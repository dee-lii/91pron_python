# VPS Manager v3 - 环境变量配置模板
# 使用方法: 复制此文件为 .env 并填入实际值

# ==================== 服务器配置 ====================
PORT=3000
NODE_ENV=production

# ==================== JWT 配置 (必须) ====================
# 生成强随机密钥: openssl rand -hex 64
# 注意: 密钥长度必须至少32字符，推荐64字节(128个十六进制字符)
JWT_SECRET=请使用openssl_rand_-hex_64生成随机密钥并替换此处
JWT_EXPIRY=24h

# ==================== Telegram 通知 (可选) ====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== 哪吒探针配置 (可选) ====================
# 如果您使用哪吒探针，请配置以下变量
NEZHA_API_URL=https://your-nezha-domain.com
NEZHA_TOKEN=请在哪吒面板生成API_Token并粘贴到此处
NEZHA_AUTO_SYNC=true
NEZHA_SYNC_INTERVAL=3600

# ==================== CORS 配置 ====================
# 允许的跨域来源，多个来源用逗号分隔
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ==================== 日志配置 ====================
LOG_LEVEL=info
